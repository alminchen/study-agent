{
    "name": "step1-chat",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "concurrently -k -n web,server -c cyan,yellow \"npm:dev:web\" \"npm:dev:server\"",
        "dev:web": "vite",
        "dev:server": "tsx watch server/index.ts",
        "build": "vue-tsc --noEmit && vite build",
        "preview": "vite preview",
        "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
        "diagrams": "node scripts/render-seq-svg.mjs",
        "diagrams:ascii": "node scripts/gen-seq-diagrams.mjs",
        "predawn:bge": "bash scripts/predawn-bge.sh",
        "predawn:rerank": "bash scripts/predawn-rerank.sh",
        "rag:preview-chunks": "tsx scripts/preview-chunks.ts",
        "rag:test-embed": "tsx scripts/test-embed.ts",
        "rag:ingest": "tsx scripts/ingest.ts",
        "rag:test-store": "tsx scripts/test-store.ts",
        "rag:search": "tsx scripts/search.ts",
        "rag:test-retrieve": "tsx scripts/test-retrieve.ts",
        "rag:test-empty": "tsx scripts/test-empty.ts",
        "rag:preview-prompt": "tsx scripts/preview-prompt.ts",
        "rag:test-prompt": "tsx scripts/test-prompt.ts",
        "rag:ask": "tsx scripts/ask.ts",
        "rag:rewrite": "tsx scripts/rewrite.ts",
        "rag:hyde": "tsx scripts/hyde.ts",
        "rag:compare-enhance": "tsx scripts/compare-enhance.ts",
        "rag:test-enhance-fallback": "tsx scripts/test-enhance-fallback.ts",
        "rag:test-rerank": "tsx scripts/test-rerank.ts",
        "mcp:stdio": "tsx server/mcp/stdio.ts",
        "mcp:ping": "tsx scripts/mcp-ping.ts",
        "eval:chat": "tsx scripts/run-evals.ts",
        "eval:multi": "tsx scripts/run-evals-multi.ts",
        "eval:plan": "tsx scripts/run-plan-evals.ts",
        "test:long-context": "tsx scripts/test-long-context.ts"
    },
    "dependencies": {
        "@huggingface/transformers": "^4.2.0",
        "@langchain/core": "^1.2.8",
        "@langchain/langgraph": "^1.4.10",
        "@lucide/vue": "^1.31.0",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "chromadb": "^3.5.0",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "langsmith": "^0.8.11",
        "onnxruntime-node": "1.16.3",
        "vue": "^3.5.13",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^22.5.0",
        "@vitejs/plugin-vue": "^5.1.4",
        "concurrently": "^8.2.2",
        "tsx": "^4.16.2",
        "typescript": "^5.5.4",
        "vite": "^5.4.0",
        "vue-tsc": "^2.1.6"
    },
    "overrides": {
        "onnxruntime-node": "1.16.3"
    },
    "resolutions": {
        "onnxruntime-node": "1.16.3"
    }
}
