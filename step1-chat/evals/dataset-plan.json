  {
    "id": "plan-order-steps",
    "messages": [{ "role": "user", "content": "先查广州天气，再查现在几点，最后总结" }],
    "expected": "plan",
    "reasonCode": "sequential_keywords",
    "scenario": "plan-order",
    "mockPlan": {
      "goal": "汇总广州天气与当前时间",
      "steps": [
        {
          "id": "step_1",
          "title": "查询广州天气",
          "action": "调用 getWeather 获取广州天气",
          "doneWhen": "拿到广州天气结果",
          "tools": ["getWeather"]
        },
        {
          "id": "step_2",
          "title": "查询当前时间",
          "action": "调用 getCurrentTime 获取当前时间",
          "doneWhen": "拿到当前时间",
          "tools": ["getCurrentTime"]
        },
        {
          "id": "step_3",
          "title": "汇总结果",
          "action": "把天气和时间汇总成一句话",
          "doneWhen": "输出同时包含天气和时间的总结",
          "tools": []
        }
      ]
    },
    "expect": {
      "mode": "plan",
      "reasonCode": "sequential_keywords",
      "plannerCalled": true,
      "planVisible": true,
      "maxSteps": 6,
      "stepOrder": ["step_1", "step_2", "step_3"],
      "doneSteps": ["step_1", "step_2", "step_3"],
      "finalStatus": "completed"
    }
  },
