# ============================================================================
# 环境变量模板
#
# 用法：cp .env.example .env
# 密钥写进 .env.local（同样格式），.env.local 优先级高于 .env，两者都不会进 Git。
# 全部变量留空或使用默认值时，服务按内置默认行为运行。
# ============================================================================

# ---------------------------------------------------------------------------
# 模型与服务
# ---------------------------------------------------------------------------
# 留空即自动进入 Mock 模式，不调用真实接口
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4.1-flash
# 设为 1 时强制 chat / plan / structured 使用 Mock；多 Agent 和 RAG 仍需真实 Key
MOCK_MODE=0
# API 端口与监听地址
PORT=18787
HOST=127.0.0.1
# 设为 test 时不打工具发现日志
NODE_ENV=

# ---------------------------------------------------------------------------
# 长上下文预算
# ---------------------------------------------------------------------------
# 上下文窗口估计值，用于计算 Token 预算
LLM_CONTEXT_WINDOW_TOKENS=64000
# 预算占窗口的比例，必须大于 0 且不超过 1
LLM_CONTEXT_BUDGET_RATIO=0.5

# ---------------------------------------------------------------------------
# Structured 输出
# ---------------------------------------------------------------------------
# 设为 0 时改用 prompt-only 约束
LLM_STRUCTURED_JSON_MODE=1
# 设为 0 时不向供应商请求流末尾 usage
LLM_STRUCTURED_INCLUDE_USAGE=1
# 超时均为毫秒，0 表示关闭
LLM_STRUCTURED_CONNECT_TIMEOUT_MS=15000
LLM_STRUCTURED_FIRST_CHUNK_TIMEOUT_MS=30000
LLM_STRUCTURED_TOTAL_TIMEOUT_MS=180000

# ---------------------------------------------------------------------------
# 输出判定（Judge）：off | shadow | enforce
# 默认 off；非法值回落 off 并告警一次
# ---------------------------------------------------------------------------
JUDGE_MODE=off
# 以下四项留空表示沿用主对话模型的配置
JUDGE_MODEL=
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_CONNECT_TIMEOUT_MS=2000
JUDGE_FIRST_CHUNK_TIMEOUT_MS=5000
JUDGE_TOTAL_TIMEOUT_MS=8000
# 送进判定的文本上限，0 表示不截断
JUDGE_MAX_INPUT_CHARS=4000
# 置信度阈值，取值 0 到 1（含两端）
JUDGE_CONFIDENCE_THRESHOLD=0.6

# ---------------------------------------------------------------------------
# 自我评估（Reflection）：off | shadow | enforce
# 服务端值是上限，请求里的模式只能往下调
# ---------------------------------------------------------------------------
REFLECTION_MODE=off

# ---------------------------------------------------------------------------
# 多模态（Vision，实施中）
# 逗号分隔的模型白名单；一旦设置就不再走模型名启发式判断
# ---------------------------------------------------------------------------
VISION_CAPABLE_MODELS=

# ---------------------------------------------------------------------------
# RAG 查询增强 · 单元 8 默认策略：扩写 + 路由（不要默认开 MULTI / HYDE）
# ---------------------------------------------------------------------------
RAG_QUERY_REWRITE=1
RAG_KB_ROUTE=1
# 多路召回 / HyDE 假文档检索：默认关闭，按需打开
# RAG_MULTI_QUERY=1
# RAG_HYDE=1
# 强制路由：notes | hr_policy | none | all
RAG_KB_ROUTE_FORCE=

# ---------------------------------------------------------------------------
# 检索与重排
# ---------------------------------------------------------------------------
# 聊天 prefetch 向量候选数（资料问答仍用默认 20），最大按 20 截断
CHAT_CANDIDATE_K=10
# 注入 system 的单段 hit 截断字数
CHAT_PREFETCH_HIT_CHARS=800
# 启动后台预热 embed/rerank（1=开，0=关）
RAG_WARMUP=1
# 重排每批条数（1=串行；默认 8）
RERANK_BATCH_SIZE=8

# ---------------------------------------------------------------------------
# 工具轮 thinking
# disabled | keep | on | enabled；当前单 Agent 标准路径显式关闭
# ---------------------------------------------------------------------------
LLM_TOOL_TURN_THINKING=disabled

# ---------------------------------------------------------------------------
# LangSmith Tracing
# 四个开关任意一个为 true 即开启；Key 与项目名建议放在 .env.local
# ---------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING_V2=false
LANGCHAIN_TRACING=false
LANGSMITH_TRACING=false
LANGCHAIN_API_KEY=
# 只是 trace 分组名，workspace 由 API Key 决定
LANGCHAIN_PROJECT=

# ---------------------------------------------------------------------------
# 仅脚本使用（服务本身不读，跑链路自测脚本时才生效）
# ---------------------------------------------------------------------------
# 链路自测脚本启动的服务端口
# CHAIN_TEST_PORT=8899
# 只跑指定标签的链路，空表示全跑
# CHAIN_FILTER=
# 链路自测里 Plan 使用的任务文本
# PLAN_TASK=
# 链路自测里 Plan 的超时（毫秒）
# PLAN_TIMEOUT_MS=240000
